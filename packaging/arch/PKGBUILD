# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=ggg
pkgver=0.16.0
pkgrel=1
pkgdesc="SVG badge and glyph generator written in Guile Scheme"
arch=('any')
url="https://codeberg.org/jjba23/ggg"
license=('AGPL-3.0-or-later')

depends=(
  'bash'
  'coreutils'
  'guile'
  'util-linux'
)

optdepends=(
  'imagemagick: render PNG badges with --convert'
  'inkscape: fallback SVG renderer for --convert when ImageMagick cannot read SVG'
)

makedepends=(
  'guile'
  'pkgconf'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('c074baace78b37b6638b53eafe0dcbbfcda46e7e3b4df182d76c960fb8a80208')

# Guile looks for byte-compiled modules under the site-ccache directory, which
# differ between distributions (and between a Guile installed system-wide and
# one from a profile), so ask Guile's pkg-config file instead of hard-coding
# Arch's /usr/lib/guile/3.0/site-ccache.
_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

build() {
  cd "$srcdir/${pkgname}"

  # Byte-compile every module, mirroring the source tree under a staging
  # directory that package() copies into the compiled site directory.
  rm -rf "$srcdir/ccache"
  mkdir -p "$srcdir/ccache/ggg"

  while IFS= read -r scm_file; do
    rel_path="${scm_file#src/}"
    go_file="$srcdir/ccache/${rel_path%.scm}.go"
    mkdir -p "$(dirname "$go_file")"
    guild compile -L src -o "$go_file" "$scm_file"
  done < <(find src/ggg -name '*.scm')
}

check() {
  cd "$srcdir/${pkgname}"

  guile -L ./src ./test/ggg-tests.scm
}

package() {
  cd "$srcdir/${pkgname}"

  # The launcher resolves its resources relative to its own prefix, so the
  # installed layout below is what scripts/ggg expects to find at runtime.
  install -Dm755 scripts/ggg "$pkgdir/usr/bin/ggg"

  install -d "$pkgdir/usr/share/guile/site/3.0/ggg"
  install -m644 src/ggg/*.scm "$pkgdir/usr/share/guile/site/3.0/ggg/"

  ccache_dir="$(_compiled_dir)"
  install -d "$pkgdir${ccache_dir}/ggg"
  cp -r "$srcdir/ccache/ggg/." "$pkgdir${ccache_dir}/ggg/"

  # The launcher shipped in the v0.16.0 tarball resolves its resources from
  # /usr/share/resources; the next upstream release moves them under
  # /usr/share/ggg/resources.  When pkgver moves past 0.16.0, change the three
  # paths below and drop this note.
  install -d "$pkgdir/usr/share/resources/logos"
  install -m644 resources/help.txt "$pkgdir/usr/share/resources/help.txt"
  cp -r resources/logos/. "$pkgdir/usr/share/resources/logos/"

  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
  install -Dm644 CREDITS.org "$pkgdir/usr/share/doc/$pkgname/CREDITS.org"

  install -d "$pkgdir/usr/share/doc/$pkgname/examples"
  install -m644 glyphs/*.scm "$pkgdir/usr/share/doc/$pkgname/examples/"
}
