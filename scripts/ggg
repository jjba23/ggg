#!/usr/bin/env bash

# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>

# Commentary:
#
# This bash script provides a convenient and user-friendly wrapper
# around the command-line usage of `ggg`, allowing the
# Guile Scheme application to behave and feel like any other
# executable or binary that users may install to their systems.
#
# This also helps installing `ggg` in a convenient fashion
# to the Guix store and it allows us to decouple the user-facing
# command-line interface from the internal Guile Scheme arguments
# to the main program and library.
#
# Some of the rationale behind the `SCRIPT_DIR` and `STORE_DIR`
# can be explained due to the need of reliably and reproducibly
# deploying source code and other resources to the store
# and have access to those at runtime.

set -euo pipefail

script_dir=$(dirname "$0")
store_dir=$(readlink -f "$script_dir/..")
scheme_sources_dir="$store_dir/share/guile/site/3.0"
resources_dir="$store_dir/share/ggg/resources"
scripts_dir="$store_dir/share/scripts"

bold_text='\033[1m'
red_text='\033[0;31m'
reset_text='\033[0m'

get_timestamp() {
  date '+%Y-%m-%d %H:%M:%S%:z'
}

log_error() {
  if [ -z "${1}" ]; then
    log_error "log-error was called without a message."
    return 1
  fi

  echo -e "${red_text}[ERROR][$(get_timestamp)] ${1}${reset_text}" >&2
}

log_info() {
  if [ -z "${1}" ]; then
    log_error "log-info was called without a message."
    return 1
  fi

  echo -e "${bold_text}[INFO][$(get_timestamp)] ${1}${reset_text}"
}

show_help() {
  cat "$resources_dir/help.txt"
}

point_to_help() {
  log_error "Try 'ggg --help' for more information."
}

if ! parsed_options=$(getopt -n "ggg" -o d:f:iochkV --long destination:,file:,stdin,stdout,convert,keep,help,version,list-colors,list-logos,gallery:,glyphs: -- "$@"); then
  point_to_help
  exit 1
fi
eval set -- "$parsed_options"

destination_arg=""
file_arg=""
stdin_arg=""
stdout_arg=""
convert_arg=""
gallery_arg=""
standalone_arg=""

guile_cmd_args=(
  "-L" "${scheme_sources_dir}"
  "-c" "((@(ggg main) main))"
  "--resources" "${resources_dir}"
)

while true; do
  case "${1}" in
  -d | --destination)
    destination_arg="${2}"
    [[ -n "${destination_arg}" ]] && guile_cmd_args+=("--destination" "${destination_arg}")
    shift 2
    ;;
  -i | --stdin)
    guile_cmd_args+=("--stdin")
    stdin_arg="true"
    shift 1
    ;;
  -o | --stdout)
    guile_cmd_args+=("--stdout")
    stdout_arg="true"
    shift 1
    ;;
  -c | --convert)
    guile_cmd_args+=("--convert")
    convert_arg="true"
    shift 1
    ;;
  -k | --keep)
    guile_cmd_args+=("--keep")
    shift 1
    ;;
  -f | --file)
    file_arg="${2}"
    shift 2
    ;;
  --list-colors)
    guile_cmd_args+=("--list-colors")
    standalone_arg="true"
    shift 1
    ;;
  --list-logos)
    guile_cmd_args+=("--list-logos")
    standalone_arg="true"
    shift 1
    ;;
  --gallery)
    gallery_arg="${2}"
    [[ -n "${gallery_arg}" ]] && guile_cmd_args+=("--gallery" "${gallery_arg}")
    standalone_arg="true"
    shift 2
    ;;
  --glyphs)
    [[ -n "${2}" ]] && guile_cmd_args+=("--glyphs" "${2}")
    standalone_arg="true"
    shift 2
    ;;
  -h | --help)
    show_help
    exit 0
    ;;
  -V | --version)
    guile_cmd_args+=("--version")
    standalone_arg="true"
    shift 1
    ;;
  --)
    shift
    break
    ;;
  *)
    log_error "Error: unrecognized option '${1}' !"
    point_to_help
    exit 1
    ;;
  esac
done

# --list-colors, --list-logos, --gallery and --glyphs do not need a glyph file
# or a destination directory.
if [[ -n "${standalone_arg}" ]]; then
  exec guile "${guile_cmd_args[@]}"
fi

if [[ (-z "${file_arg}") && (-z "${stdin_arg}") ]]; then
  log_error "Error: A glyph configuration is required!" >&2
  log_error "Use -f / --file PATH, or -i / --stdin to read it from a pipe." >&2
  point_to_help
  exit 1
fi

if [[ -n "${file_arg}" && ! -f "${file_arg}" ]]; then
  log_error "Error: Glyph file not found: ${file_arg}" >&2
  log_error "Check the path you passed to -f / --file." >&2
  point_to_help
  exit 1
fi

if [[ -n "${file_arg}" ]]; then
  guile_cmd_args+=("--file" "$(realpath "${file_arg}")")
fi

if [[ (-z "${stdout_arg}") && (-z "${destination_arg}") ]]; then
  log_error "Error: Either the destination or stdout options are required!" >&2
  log_error "Use -d / --destination or alternatively -o / --stdout." >&2
  point_to_help
  exit 1
fi

if [[ (-n "${stdout_arg}") && (-n "${convert_arg}") ]]; then
  log_error "Error: Cannot combine stdout and convert options!" >&2
  point_to_help
  exit 1
fi

if [[ -z "${stdout_arg}" ]]; then
  log_info "Starting Guile Glyph Generator: guile ${guile_cmd_args[*]}"
fi

# Run Guile application
exec guile "${guile_cmd_args[@]}"
